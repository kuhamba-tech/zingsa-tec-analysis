FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ZGIIS_SKIP_DB_SCHEMA_INIT=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin zgiis

COPY requirements.txt /tmp/requirements-root.txt
COPY backend/requirements.txt /tmp/requirements-backend.txt
RUN pip install --no-cache-dir -r /tmp/requirements-root.txt -r /tmp/requirements-backend.txt \
    && rm -f /tmp/requirements-root.txt /tmp/requirements-backend.txt

COPY backend ./backend
COPY zgiis ./zgiis
COPY tec_core.py ./tec_core.py
COPY scripts/live_ntrip_collector.py scripts/collector_db_host.py ./scripts/
COPY docker/collector-entrypoint.sh /entrypoint.sh

RUN sed -i 's/\r$//' /entrypoint.sh \
    && chmod 755 /entrypoint.sh \
    && mkdir -p /app/static/data \
    && chown -R zgiis:zgiis /app

USER root
ENTRYPOINT ["/entrypoint.sh"]
