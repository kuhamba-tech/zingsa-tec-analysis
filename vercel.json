{
  "regions": ["lhr1"],
  "framework": "nextjs",
  "installCommand": "npm install --package-lock=false && cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "functions": {
    "api/space-weather-router.py": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/tec-router.py": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/cors-router.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/core-router.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/navigation-news",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/early-warning",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/power-grid-advisory",
      "schedule": "0 4,10,16,22 * * *"
    },
    {
      "path": "/api/cron/power-grid-quarter",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    }
  ]
}
